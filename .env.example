# Copy to `.env` and adjust. Every setting is optional.

# --- Access ------------------------------------------------------------------
# Interviewer sign-in token. Leave empty to have one generated on first start
# (print the sign-in link with `./twofold url`).
TWOFOLD_ADMIN_TOKEN=
# Port on this machine.
TWOFOLD_PORT=7777
# Interface to listen on. 127.0.0.1 keeps it on this machine; 0.0.0.0 exposes it
# to your network.
TWOFOLD_BIND=127.0.0.1
# The address candidates use, e.g. a tunnel or reverse-proxy URL. When empty,
# candidate links use whatever address you opened the interviewer UI on.
TWOFOLD_PUBLIC_URL=
# Where candidates reach the three previews (merged, A, B), comma-separated,
# when it isn't this host on ports 7778-7780, e.g. behind a tunnel:
#   TWOFOLD_PREVIEW_URLS=https://merged.example.com,https://a.example.com,https://b.example.com
TWOFOLD_PREVIEW_URLS=

# --- Assistants ----------------------------------------------------------------
# Instead of `./twofold login claude`, you can paste a token from
# `claude setup-token` (run on any machine with a browser; bills your Claude
# subscription, valid for a year).
CLAUDE_CODE_OAUTH_TOKEN=
# Pin CLI versions for reproducible images (default: latest at build time).
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
# How long one agent run may take before it is stopped.
TWOFOLD_AGENT_TIMEOUT_MINUTES=30
# Show the deterministic mock assistant (for demos without a subscription).
TWOFOLD_ENABLE_MOCK=0

# --- Repositories --------------------------------------------------------------
# Host folder with local git repositories, mounted read-only at /repos.
TWOFOLD_REPOS=./repos
# Extra Debian packages for the toolchains your repositories need.
EXTRA_APT_PACKAGES=
# Extra environment variable names passed through to setup/check commands and
# the assistants (comma-separated), e.g. GITHUB_TOKEN.
TWOFOLD_PASSTHROUGH_ENV=
